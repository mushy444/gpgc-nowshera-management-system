# Local development only. Use the hosting provider's secret manager in production.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
# SQLite is for local development only. Production must use a managed PostgreSQL/MySQL database.
DATABASE_URL=sqlite:///gpgc_saas.db
# Set true only when intentionally creating the initial schema in a controlled environment.
BOOTSTRAP_DB=false
# Set before creating the initial admin account; never use the example password in production.
INITIAL_ADMIN_PASSWORD=replace-this-with-a-unique-strong-password
